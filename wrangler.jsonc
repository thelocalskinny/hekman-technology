{
  "name": "hekman-technology",
  "compatibility_date": "2025-06-01",
  "main": "worker.js",
  "routes": [
    { "pattern": "hekmantechnology.com", "custom_domain": true },
    { "pattern": "www.hekmantechnology.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": ["/", "/privacy", "/terms"]
  }
}
